name: Deploy Docker to Hugging Face Space

on:
  push:
    branches: [main]
  workflow_dispatch:   # lets you run it manually from GitHub UI

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # 1. Login to Hugging Face container registry
      - name: Login to HF Registry
        run: |
          echo "${{ secrets.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 }}" | docker login registry.huggingface.co -u muddasser --password-stdin

      # 2. Build and push your image directly to your Space's private registry
      - name: Build & Push Docker image
        run: |
          docker build . -t registry.huggingface.co/spaces/muddasser/creditcarddocker/app:latest
          docker build . -t registry.huggingface.co/spaces/muddasser/creditcarddocker/app:${{ github.sha }}
          docker push registry.huggingface.co/spaces/muddasser/creditcarddocker/app:latest
          docker push registry.huggingface.co/spaces/muddasser/creditcarddocker/app:${{ github.sha }}

      # 3. Restart the Space so it instantly picks up the new image
      - name: Restart Hugging Face Space
        run: |
          curl -X POST \
            -H "Authorization: Bearer ${{ secrets.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 }}" \
            https://huggingface.co/api/spaces/muddasser/creditcarddocker/restart
